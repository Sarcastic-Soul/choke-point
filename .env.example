# Copy to .env.local and fill in. Variables are the same locally and on Vercel.

# FalkorDB. Local Docker default shown. For FalkorDB Cloud use falkor://<host>:<port> plus username and password (falkors:// if your plan has TLS).
FALKORDB_URL=falkor://localhost:6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# Optional. Without a key the agent runs in offline mode (fixed investigation, answer built from query rows).
GOOGLE_GENERATIVE_AI_API_KEY=
AGENT_MODEL=gemini-2.5-flash-lite
# Max model calls per day on a public deployment. Past it, answers come from the graph alone.
AGENT_DAILY_LIMIT=400
